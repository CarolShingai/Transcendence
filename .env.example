# Copie para .env (nao versionado) e ajuste se necessario.
# IMPORTANTE: NUNCA commitar este arquivo com valores reais no repositório!

# ============================================
# DATABASE CREDENTIALS (MYSQL)
# ============================================
MYSQL_ROOT_PASSWORD=change_me_root_password_123!@#
MYSQL_USER=transcendence_user
MYSQL_PASSWORD=change_me_db_password_456!@#
MYSQL_DATABASE=transcendence_db

# ============================================
# BACKEND SPRING CONFIGURATION
# ============================================
SPRING_PROFILES_ACTIVE=dev

# JWT Authentication
JWT_SECRET=your_very_secure_random_jwt_secret_key_min_32_chars_CHANGE_THIS
JWT_EXPIRATION_MS=86400000

# OAuth2 Google Configuration
GOOGLE_CLIENT_ID=your_google_oauth2_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth2_client_secret

# ============================================
# SSL / HTTPS
# ============================================
SSL_KEYSTORE_PASSWORD=changeit
SSL_KEYSTORE_TYPE=PKCS12
SSL_KEY_ALIAS_DEV=transcendence-dev
SSL_KEY_ALIAS_PROD=transcendence-prod

# (prod compose) caminho do keystore dentro do container
# Se voce mantiver o volume ./Backend/certs:/app/certs:ro
SSL_KEYSTORE_PATH=file:/app/certs/keystore-prod.p12

# ============================================
# CORS (backend) - origins permitidos
# ============================================
APP_CORS_ALLOWED_ORIGINS_DEV=http://localhost:3000
APP_CORS_ALLOWED_ORIGINS_PROD=http://localhost:8080

# ============================================
# Frontend base URL for OAuth2 redirects
# ============================================
APP_FRONTEND_BASE_URL_DEV=http://localhost:3000
APP_FRONTEND_BASE_URL_PROD=http://localhost:8080

# ============================================
# GRAFANA MONITORING
# ============================================
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me_grafana_password_789!@#
GF_USERS_ALLOW_SIGN_UP=false
GF_INSTALL_PLUGINS=grafana-piechart-panel
